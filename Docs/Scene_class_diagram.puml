@startuml Scene_class_diagram

top to bottom direction

package game {
    interface Scene {
        + Name() string
        + Update(active bool) (nextScene Utils.Factory[Scene], transitionType transition.Type, err error)
        + Draw(screen *ebiten.Image)
    }
}

package scene {
    interface WorldDrawer {
        + Draw(screen *ebiten.Image, objects []Entity)
        + SetCenter(center Utils.Position)
    }

    interface UIDrawer {
        + Draw(screen *ebiten.Image, objects []Element)
    }

    interface Element {
        + Update(active bool) error
        + Draw(screen *ebiten.Image)
    }

    interface Entity {
        + Name() string
        + Update(active bool) error
        + Draw() (image *ebiten.Image, Layer string)
        + Position() Utils.Position
    }

    class "各種Scene" as HogeScene {
        - entities []Entity
        - elements []Element
        - worldDrawer WorldDrawer
        - uiDrawer UIDrawer
        + Name() string
        + Update(active bool) (nextScene Utils.Factory[game.Scene], transitionType transition.Type, err error)
        + Draw(screen *ebiten.Image)
    }

    note right of HogeScene
    PlayScene
    TitleScene
    PauseScene
    TrainScene
    ResultScene
    end note


    class Camera {
        - center Utils.Position
        - layers map[string]int
        + Draw(screen *ebiten.Image, objects []Entity)
        + SetCenter(center Utils.Position)
    }

    class UICamera {
        + Draw(screen *ebiten.Image, objects []Element)
    }
}

package gameObject {
    class GameObject {
        - name string
        - tf Transform
        - rd Render
        - cmps []Component
        + Scene *scene.PlayScene
        + Name() string
        + Update(active bool) error
        + Draw() (image *ebiten.Image, Layer string)
        + Position() Utils.Position
        + AddComponent(component Component) error
        + GetComponent(target reflect.Type) (Component, error)
    }

    interface Transform {
        + Position() Utils.Position
        + SetPosition(position Utils.Position)
    }

    interface Render {
        + Draw() (image *ebiten.Image, Layer string)
    }

    interface Component {
        + Update(active bool) error
    }
}

package component {
    class "コンポーネント実装" as CompImpl {
        + Update(active bool) error
    }
}

package ui {
    class "UI実装" as UIImpl
}

scene.HogeScene .up.|> game.Scene

scene.HogeScene "1" *-down- "0..*" scene.Entity
scene.HogeScene "1" *-down- "0..*" scene.Element
scene.HogeScene -down-> scene.WorldDrawer
scene.HogeScene -down-> scene.UIDrawer

scene.Camera .up.|> scene.WorldDrawer
scene.UICamera .up.|> scene.UIDrawer

gameObject.GameObject ..up..|> scene.Entity
gameObject.GameObject *-down- gameObject.Transform
gameObject.GameObject *-down- gameObject.Render
gameObject.GameObject "1" *-down- "0..*" gameObject.Component

component.CompImpl .up.|> gameObject.Component

ui.UIImpl ..up..|> scene.Element

@enduml
