@startuml Scene_class_diagram

package transition {
    class Type{}
}

package game {
    interface Scene {
        + Name() string
        + Update(active bool) (nextScene SceneFactory, transitionType transition.Type, err error)
        + Draw(screen *ebiten.Image)
    }

    Scene .right.> transition.Type
}

package scene {
    class PlayScene {
        - objects []Entity
        + NewPlayScene() Utils.Factory[PlayScene]
        + Name() string
        + Update(active bool) (nextScene Utils.Factory[Scene], transitionType transition.Type, err error)
        + Draw(screen *ebiten.Image)
    }
    note right of PlayScene : Update() は　objects.Update() を呼ぶ\nDraw() は　objects.Draw() を呼ぶ\nNewHogeScene() の型は関数型をいい感じに命名したもの

    PlayScene -up-|> game.Scene
    PlayScene .up.> transition.Type


    PlayScene "1" *-- "0..*" Entity

    interface Entity {
        + Name() string
        + Update(active bool) (err error)
        + Draw(screen *ebiten.Image)
    }
}

package gameObject {
    class GameObject {
        - name string
        - transform() Transform
        - render() Render
        - components() []Component
        + Name() string
        + NewHogeObject(NewTransform Utils.Factory[Transform], NewRender Utils.Factory[Render]) (*HogeObject, error)
        + AddComponent(c Component)
        + GetComponent[T | Component]() T, error
    }
    note right of GameObject : 標準的なゲームオブジェクト\n原則これのインスタンスを使う\n違うタイプのゲームオブジェクトが欲しければ手書き実装\nDraw(sc) は render.Draw(g, sc) を呼ぶ\nUpdate() は components の Update() を呼ぶ

    GameObject -up-|> scene.Entity
    GameObject *-- Transform
    GameObject *-- Render

    GameObject "1" *-- "0..*" Component

    interface Transform {
        + Position Position
    }

    interface Render {
        + Draw(screen *ebiten.Image)
    }

    interface Component {
        + Update(obj GameObject, active bool) (err error)
    }
}

package Component {
    class FugaComponent {
        + NewFugaComponent(obj GameObject) (*HogeComponent, error)
    }

    FugaComponent -up-|> gameObject.Component

    class StdTransform {
        + Position Position
        + NewTransform() (*Transform, error)
    }

    StdTransform -up-|> gameObject.Transform

    class StdRender {
        - obj GameObject
        + NewRender(obj GameObject) (*Render, error)
        + Draw(screen *ebiten.Image)
    }

    StdRender -up-|> gameObject.Render
}
@enduml