@startuml TileMap_class_diagram

top to bottom direction

package gameObject {
    interface Transform {
        + Position() Utils.Position
        + SetPosition(Utils.Position)
    }

    interface Component {
        + Update(active bool) error
    }
}

package tilemap {
    class TileData {
        + Name string
        + ImageData imageassets.ImageData
        + Layer string
        + Size Utils.Vec2Int
        + Interact InteractType
    }

    enum InteractType {
        None
        Shelf
    }

    class TileMapData {
        + MapData map[TilePosition]*TileData
        + TileSize Utils.Vec2Int
        + Enterable map[Utils.Vec2Int]bool
    }

    class TilePosition {
        + Position Utils.Vec2Int
        + Layer string
        + Offset Utils.Vec2
        + Move(Direction Utils.Vec2Int)
    }
}

package component {
    class Tile {
        + Data tilemap.TileData
        + Update(active bool) error
    }

    class TileMap {
        + Tiles map[tilemap.TilePosition]*Tile
        + TileSize Utils.Vec2Int
        + Enterable map[Utils.Vec2Int]bool
        + Interact map[Utils.Vec2Int]InteractableTile
        + Update(active bool) error
        + SetGameObject(...)
        + TilePositionToWorldPosition(pos tilemap.TilePosition, data tilemap.TileData) Utils.Position
    }

    class TileWalker {
        + Data tilemap.TileData
        + Position tilemap.TilePosition
        - tf gameobject.Transform
        - tm *TileMap
        + Update(active bool) error
        + Move(Direction Utils.Vec2Int)
    }

    interface InteractableTile {
        + Interact() error
        + Update(active bool) error
    }

    class ShelfTile {
        + Interact() error
        + Update(active bool) error
    }

    class StdTransform {
        - position Utils.Position
        + Position() Utils.Position
        + SetPosition(pos Utils.Position)
    }

}

' Inheritance and implementation
component.Tile .up.|> gameObject.Component
component.TileMap .up.|> gameObject.Component
component.TileWalker .up.|> gameObject.Component
component.InteractableTile .up.|> gameObject.Component
component.ShelfTile .up.|> component.InteractableTile
component.StdTransform .up.|> gameObject.Transform

' Composition and references
component.TileMap "1" *-- "0..*" component.Tile
component.TileMap "0..*" o-right- "0..*" component.InteractableTile
component.TileWalker -right-> component.TileMap
component.TileWalker --> gameObject.Transform
tilemap.TileMapData "1" *-- "0..*" tilemap.TilePosition
tilemap.TileMapData "1" *-up- "0..*" tilemap.TileData
tilemap.TileData --> tilemap.InteractType
component.Tile --> tilemap.TileData
component.TileMap --> tilemap.TileMapData
component.TileWalker --> tilemap.TileData
component.TileWalker *-- tilemap.TilePosition
' component.ShelfTile .up.> gameObject.Component

@enduml
